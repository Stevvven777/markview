{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@markview/viewer": ["../web/packages/markview/src/index.ts"],
      "@markview/scroll-sync": ["../web/packages/scroll-sync/src/index.ts"],
      "@markview/fonts": ["../web/packages/fonts/src/index.ts"],
      "@markview/resources": ["../web/packages/resources/src/index.ts"]
    }
  },
  "include": ["vscode/src/**/*.ts", "tests/**/*.ts"]
}
