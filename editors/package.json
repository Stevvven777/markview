{
  "name": "markview-editors",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && prettier --check \"vscode/src/**/*.ts\" \"tests/**/*.mjs\" \"*.mjs\" \"*.json\"",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "get-system-fonts": "2.0.2"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
