{
	"name": "markview-preview",
	"displayName": "Markview Preview",
	"description": "Read Markdown in a side-by-side preview typeset by the Markview engine.",
	"version": "0.1.0",
	"publisher": "Stevvven",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/vscode/src/extension.js",
	"activationEvents": [],
	"contributes": {
		"commands": [
			{
				"command": "markview.openPreview",
				"title": "Markview: Open Preview to the Side",
				"icon": "$(preview)"
			},
			{
				"command": "markview.closePreview",
				"title": "Markview: Close Preview"
			},
			{
				"command": "markview.exportPdf",
				"title": "Markview: Export to PDF"
			},
			{
				"command": "markview.revealSource",
				"title": "Markview: Reveal the Source of the Selection"
			},
			{
				"command": "markview.exportPng",
				"title": "Markview: Export to PNG"
			},
			{
				"command": "markview.exportWithTemplate",
				"title": "Markview: Export with Template\u2026"
			},
			{
				"command": "markview.copySelection",
				"title": "Markview: Copy Preview Selection"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "markview.openPreview",
					"when": "editorLangId == markdown",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "markview.openPreview",
					"when": "editorLangId == markdown"
				},
				{
					"command": "markview.closePreview"
				},
				{
					"command": "markview.exportPdf",
					"when": "editorLangId == markdown"
				},
				{
					"command": "markview.revealSource"
				},
				{
					"command": "markview.exportPng",
					"when": "editorLangId == markdown"
				},
				{
					"command": "markview.exportWithTemplate",
					"when": "editorLangId == markdown"
				},
				{
					"command": "markview.copySelection"
				}
			],
			"webview/context": [
				{
					"command": "markview.copySelection",
					"when": "webviewId == 'markview.preview'",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "Markview",
			"properties": {
				"markview.enginePath": {
					"scope": "machine",
					"type": "string",
					"default": "",
					"markdownDescription": "The Markview executable. Empty uses the one shipped with this extension."
				},
				"markview.fontSize": {
					"scope": "language-overridable",
					"type": "number",
					"default": 18,
					"minimum": 6,
					"maximum": 48,
					"markdownDescription": "Body text size in layout pixels."
				},
				"markview.columnWidth": {
					"scope": "language-overridable",
					"type": "number",
					"default": 760,
					"minimum": 240,
					"maximum": 1600,
					"markdownDescription": "The reading column's width in layout pixels."
				},
				"markview.justify": {
					"scope": "language-overridable",
					"type": "boolean",
					"default": false,
					"markdownDescription": "Set prose flush on both sides."
				},
				"markview.hyphenate": {
					"scope": "language-overridable",
					"type": "boolean",
					"default": true,
					"markdownDescription": "Hyphenate where the document's language allows it."
				},
				"markview.paragraphIndent": {
					"scope": "language-overridable",
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 4,
					"markdownDescription": "First-line indent in multiples of the text size."
				},
				"markview.codeblockWrap": {
					"scope": "language-overridable",
					"type": "boolean",
					"default": false,
					"markdownDescription": "Wrap code block lines at the column instead of scrolling them."
				},
				"markview.scrollSync": {
					"scope": "language-overridable",
					"type": "boolean",
					"default": true,
					"markdownDescription": "Keep the preview and the editor at the same place."
				},
				"markview.template": {
					"scope": "language-overridable",
					"type": "string",
					"default": "",
					"markdownDescription": "The template an export uses: a template name such as `mondrian`, or the path of a `.mvss.toml`. Empty uses the bundled print sheet."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p tsconfig.json",
		"watch": "tsc -p tsconfig.json --watch",
		"test": "./run-tests.sh",
		"package": "./package-vsix.sh",
		"vscode:prepublish": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.95.0",
		"typescript": "^5.6.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/szdytom/markview.git",
		"directory": "editors/vscode"
	},
	"icon": "icon.png",
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "The preview starts a native engine and resolves local resources."
		},
		"virtualWorkspaces": {
			"supported": false,
			"description": "The native engine requires local document paths."
		}
	}
}
