{
  "version": "0.3.0",
  "publisher": "szdytom",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szdytom/markview"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "icon": "icon.png",
  "scripts": {
    "vscode:prepublish": "node ../build.mjs"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Markview reads local fonts and launches its packaged exporter."
    }
  },
  "name": "markview",
  "displayName": "Markview Preview & Export",
  "description": "Markview font management, Markdown preview and export.",
  "contributes": {
    "commands": [
      {
        "command": "markview.fonts",
        "title": "字体管理…",
        "category": "Markview"
      },
      {
        "command": "markview.preview.open",
        "title": "打开侧边预览",
        "category": "Markview",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      },
      {
        "command": "markview.export.pdf",
        "title": "导出 PDF…",
        "category": "Markview"
      },
      {
        "command": "markview.export.png",
        "title": "导出 PNG…",
        "category": "Markview"
      },
      {
        "command": "markview.export.template",
        "title": "使用模板导出…",
        "category": "Markview"
      }
    ],
    "configuration": {
      "title": "Markview",
      "properties": {
        "markview.fontDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional local font directories."
        },
        "markview.previewStyleFile": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom MVSS stylesheet supporting the ui destination."
        },
        "markview.exportTemplate": {
          "type": "string",
          "default": "default",
          "description": "Default export template ID."
        },
        "markview.exportFontSize": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "description": "Export font size in pixels."
        },
        "markview.exportScale": {
          "type": "number",
          "default": 2,
          "minimum": 0.1,
          "description": "PNG output scale."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "markview.preview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markview.export.pdf",
          "when": "editorLangId == markdown",
          "group": "markview"
        },
        {
          "command": "markview.export.png",
          "when": "editorLangId == markdown",
          "group": "markview"
        },
        {
          "command": "markview.export.template",
          "when": "editorLangId == markdown",
          "group": "markview"
        }
      ]
    }
  },
  "activationEvents": [
    "onWebviewPanel:markview.preview"
  ]
}
