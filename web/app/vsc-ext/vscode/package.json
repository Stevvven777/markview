{
  "version": "0.3.0",
  "publisher": "szdytom",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szdytom/markview"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "icon": "icon.png",
  "scripts": {
    "vscode:prepublish": "node ../build.mjs"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Markview reads local fonts and launches its packaged exporter."
    }
  },
  "name": "markview",
  "displayName": "Markview Preview & Export",
  "description": "Markview font management and side-by-side Markdown preview.",
  "contributes": {
    "commands": [
      {
        "command": "markview.fonts",
        "title": "字体管理…",
        "category": "Markview"
      },
      {
        "command": "markview.preview.open",
        "title": "打开侧边预览",
        "category": "Markview",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      }
    ],
    "configuration": {
      "title": "Markview",
      "properties": {
        "markview.fontDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional local font directories."
        },
        "markview.previewStyleFile": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom MVSS stylesheet supporting the ui destination."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "markview.preview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onWebviewPanel:markview.preview"
  ]
}
