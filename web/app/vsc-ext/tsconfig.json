{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["vscode/src/**/*.ts"]
}
